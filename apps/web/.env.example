# Copy to .env.local

# The model runs on Cloudflare Workers AI through apps/model (`pnpm --filter visuals-model dev`).
MODEL_URL=http://127.0.0.1:8787
# Only for a deployed model worker: the same value as its MODEL_PROXY_TOKEN secret.
MODEL_PROXY_TOKEN=
# Used to label runs and estimate cost (USD per million tokens). Defaults: glm-4.7-flash.
MODEL_NAME=@cf/zai-org/glm-4.7-flash
MODEL_INPUT_COST_PER_MILLION=0.0605
MODEL_OUTPUT_COST_PER_MILLION=0.40
# Each run makes real model calls. Cap across all users per day.
LIVE_RUNS_PER_DAY=50

# kaibo memory (https://kaibo.egeuysal.com). Create a project API key that can read and write.
# Without it, runs work and memory is reported as off.
KAIBO_KEY=
KAIBO_URL=https://kaibo.egeuysal.com
# Project id. Required with an organization wide key.
KAIBO_PROJECT=

# 32+ random characters. Required in production; generated into .data/ in dev.
SESSION_SECRET=
