# Copy to .env.local for local development. In production, KAIBO_KEY and SESSION_SECRET are
# worker secrets (`wrangler secret put`) and the rest are vars in wrangler.jsonc.

# kaibo memory (https://kaibo.egeuysal.com). A project API key that can read and write.
# Without it, comparisons work and memory is reported as off.
KAIBO_KEY=
KAIBO_URL=https://kaibo.egeuysal.com
# Project id. Required with an organization wide key.
KAIBO_PROJECT=

# 32+ random characters. Required in production. In dev a temporary one is made if empty.
SESSION_SECRET=

# Optional. Cost is estimated from token counts (USD per million tokens, defaults: glm-4.7-flash).
MODEL_INPUT_COST_PER_MILLION=
MODEL_OUTPUT_COST_PER_MILLION=
# Daily caps on comparisons, which make real model calls: everyone together, and each account.
LIVE_RUNS_PER_DAY=200
USER_RUNS_PER_DAY=20
