{
  "name": "visuals-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:local": "wrangler d1 migrations apply sdk --local",
    "db:remote": "wrangler d1 migrations apply sdk --remote",
