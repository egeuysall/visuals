{
  "name": "navo-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A framework-neutral runtime for faster, cheaper tool-using AI agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "web": "pnpm --filter visuals-web dev",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "benchmark": "pnpm --filter navo-example-benchmark start",
    "benchmark:general": "pnpm --filter navo-example-benchmark general",
    "release:check": "node scripts/publish-packages.mjs --dry-run",
    "release:publish": "node scripts/publish-packages.mjs",
    "prepublishOnly": "node -e \"throw new Error('Workspace root is not publishable; run pnpm release:publish')\"",
    "convex:dev": "pnpm exec convex dev",
    "convex:deploy": "pnpm exec convex deploy",
    "convex:codegen": "pnpm exec convex codegen",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck && pnpm exec tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "convex": "^1.43.0"
  },
  "dependencies": {
    "@runto/protocol": "workspace:*",
    "zod": "^4.4.3"
  }
}
