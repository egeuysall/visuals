{
  "name": "@runto/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/egeuysall/sdk"
  },
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "navo": "bin/navo.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@runto/core": "workspace:*",
    "@runto/protocol": "workspace:*",
    "@runto/gateway": "workspace:*"
  }
}
