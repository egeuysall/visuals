# Optional live provider. Local examples and tests use deterministic providers
# unless AI_GATEWAY_API_KEY is set.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5
NAVO_BENCHMARK_LIVE=1
NAVO_BENCHMARK_TASKS=3
NAVO_BENCHMARK_TREATMENT_REASONING_EFFORT=low
NAVO_BENCHMARK_INPUT_COST_PER_MILLION=1.25
NAVO_BENCHMARK_OUTPUT_COST_PER_MILLION=10
NAVO_RUN_TIMEOUT_MS=120000
NAVO_INCIDENT_TOOL_DELAY_MS=120
NAVO_INCIDENT_MAX_CONCURRENCY=12
NAVO_GENERAL_BENCHMARK_TASKS=12
NAVO_GENERAL_TOOL_DELAY_MS=30

# Optional hosted event persistence through Convex.
NAVO_CONVEX_URL=
NAVO_CONVEX_INGEST_KEY=

# Direct provider adapters remain available when you do not use the gateway.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gateway defaults
NAVO_HOST=127.0.0.1
NAVO_PORT=8787
NAVO_PROJECT_ID=local-demo
NAVO_ENVIRONMENT=development
NAVO_API_KEY=
NAVO_ALLOWED_TOOLS=
NAVO_RATE_LIMIT_PER_MINUTE=120

# Managed adapters are intentionally optional in local development.
DATABASE_URL=
REDIS_URL=
CLICKHOUSE_URL=
BLOB_STORAGE_BUCKET=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
